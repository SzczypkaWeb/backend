PORT=3000

# Allowed CORS origin for the API. Defaults to the local frontend dev server
# if not set.
CORS_ORIGIN=http://localhost:8080

DB_USER=dev
DB_PASSWORD=dev_password
DB_NAME=projekt

DATABASE_URL="postgresql://dev:dev_password@localhost:5432/projekt?schema=public"

# Google OAuth 2.0 credentials (from the Google Cloud Console).
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback