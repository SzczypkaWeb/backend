PORT=3000

# Allowed CORS origin for the API. Defaults to the local frontend dev server
# if not set.
CORS_ORIGIN=http://localhost:8080

DB_USER=dev
DB_PASSWORD=dev_password
DB_NAME=projekt

DATABASE_URL="postgresql://dev:dev_password@localhost:5432/projekt?schema=public"

# Google OAuth 2.0 credentials (from the Google Cloud Console).
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# Origin the Google OAuth callback redirects the browser back to once auth
# cookies are set. Required at startup (see src/config/env.validation.ts).
FRONTEND_ORIGIN=http://localhost:8080

# Optional. Controls the SameSite attribute of the auth cookies outside
# production (production always uses 'none'). Leave unset for plain local
# HTTP dev - defaults to 'lax'. Set to 'none' only when testing the Google
# OAuth flow locally through an HTTPS tunnel (e.g. ngrok), since 'none'
# requires the Secure attribute, which requires HTTPS to actually be stored
# by the browser.
# COOKIE_SAME_SITE=none