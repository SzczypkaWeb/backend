// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider      = "prisma-client-js"
  output        = "../generated/prisma"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  // Nullable: Google-only users (no email/password signup) have no password.
  passwordHash String?
  // Google account subject id, set for users who signed up/linked via Google OAuth.
  googleId     String?  @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // How the account was created. This is additive metadata alongside the
  // existing nullable `googleId` field (which already tells you whether an
  // account is linked to Google) rather than a replacement for it - the
  // account-linking logic in AuthService keeps using `googleId`.
  authProvider    AuthProvider @default(email)
  emailVerifiedAt DateTime?
  phone           String?
  phoneVerifiedAt DateTime?
  status          UserStatus   @default(pending_verification)

  providerProfile ProviderProfile?
  clientProfile   ClientProfile?
  phoneOtps       PhoneOtp[]

  sentMessages          Message[]
  assistantConversations AssistantConversation[]
  context               UserContext?
}

enum AuthProvider {
  email
  google
}

enum UserStatus {
  pending_verification
  active
  banned
}

model Listing {
  id          String   @id @default(uuid())
  title       String
  description String
  // Price stored in cents (integer) to avoid floating-point rounding issues.
  price       Int
  location    String   @default("")
  viewCount   Int      @default(0)
  createdAt   DateTime @default(now())
}

// --- Service marketplace domain -------------------------------------------
//
// Providers offer services under one or more categories; clients post
// service requests (either asking for a quote, or with a fixed budget
// range) and providers respond with quotes.
//
// Geolocation (baseLat/baseLng/lat/lng) is stored as plain floats for now.
// PostGIS/GiST proximity indexing is deliberately deferred to a later task
// once real radius search is being built.

model ServiceCategory {
  id       String  @id @default(uuid())
  name     String
  slug     String  @unique
  parentId String?

  parent   ServiceCategory?  @relation("ServiceCategoryHierarchy", fields: [parentId], references: [id])
  children ServiceCategory[] @relation("ServiceCategoryHierarchy")

  providerCategories ProviderCategory[]
  serviceRequests    ServiceRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId])
}

enum VerificationStatus {
  pending
  verified
  rejected
}

model ProviderProfile {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  nip            String
  companyName    String
  companyAddress String

  verificationStatus VerificationStatus @default(pending)

  // Plain lat/lng floats - see module note above re: deferred PostGIS.
  baseLat         Float
  baseLng         Float
  baseAddress     String
  serviceRadiusKm Int

  bio String?

  categories ProviderCategory[]
  quotes     Quote[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  conversations Conversation[]
}

model ProviderCategory {
  providerId String
  categoryId String

  provider ProviderProfile @relation(fields: [providerId], references: [id])
  category ServiceCategory @relation(fields: [categoryId], references: [id])

  @@id([providerId, categoryId])
  @@index([categoryId])
}

model ClientProfile {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  serviceRequests ServiceRequest[]
  conversations   Conversation[]

  createdAt DateTime @default(now())
}

enum ServiceRequestStatus {
  open
  matched
  closed
}

model ServiceRequest {
  id String @id @default(uuid())

  clientId String
  client   ClientProfile @relation(fields: [clientId], references: [id])

  categoryId String
  category   ServiceCategory @relation(fields: [categoryId], references: [id])

  description String
  address     String

  // Plain lat/lng floats - see module note above re: deferred PostGIS.
  lat Float
  lng Float

  needsQuote Boolean

  // Only meaningful when needsQuote is false; null when the client asked
  // for a quote instead of naming a budget.
  budgetMin Decimal? @db.Decimal(10, 2)
  budgetMax Decimal? @db.Decimal(10, 2)

  desiredDate DateTime? @db.Date

  status ServiceRequestStatus @default(open)

  photos        RequestPhoto[]
  quotes        Quote[]
  conversations Conversation[]
  createdAt     DateTime       @default(now())

  @@index([status, categoryId])
}

model RequestPhoto {
  id String @id @default(uuid())

  requestId String
  request   ServiceRequest @relation(fields: [requestId], references: [id])

  url       String
  sortOrder Int

  @@index([requestId])
}

enum QuoteStatus {
  pending
  accepted
  rejected
}

model Quote {
  id String @id @default(uuid())

  requestId String
  request   ServiceRequest @relation(fields: [requestId], references: [id])

  providerId String
  provider   ProviderProfile @relation(fields: [providerId], references: [id])

  price   Decimal @db.Decimal(10, 2)
  message String?

  status QuoteStatus @default(pending)

  createdAt DateTime @default(now())

  @@index([requestId])
  @@index([providerId])
}

model PhoneOtp {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  code      String
  expiresAt DateTime

  verifiedAt DateTime?

  @@index([userId])
}

// --- Messaging + shared cross-module context -------------------------------
//
// Two independent "chat modules": real human-to-human Conversation/Message
// (client <-> provider, scoped to one ServiceRequest since a request can have
// several providers quoting, each gets its own thread), and AssistantConversation/
// AssistantMessage (user <-> AI assistant, e.g. "help me describe my request").
// Both read/write UserContext - a single per-user row that acts as the shared
// memory the two modules communicate through (recent searches, recently viewed
// listings, a rolling AI-maintained summary of what the user is currently doing).

model Conversation {
  id String @id @default(uuid())

  requestId String
  request   ServiceRequest @relation(fields: [requestId], references: [id])

  clientId String
  client   ClientProfile @relation(fields: [clientId], references: [id])

  providerId String
  provider   ProviderProfile @relation(fields: [providerId], references: [id])

  messages Message[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // One thread per (request, provider) pair - not per request alone, since
  // several providers can quote the same request and each needs its own thread.
  @@unique([requestId, providerId])
  @@index([clientId])
  @@index([providerId])
}

model Message {
  id String @id @default(uuid())

  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])

  // Whichever User sent it - could be the client or the provider's user
  // account, no separate "role" needed since Conversation already knows both.
  senderId String
  sender   User   @relation(fields: [senderId], references: [id])

  body String

  createdAt DateTime @default(now())

  @@index([conversationId, createdAt])
}

enum AssistantMessageRole {
  user
  assistant
}

model AssistantConversation {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  // Optional, short auto-generated label (e.g. first user message truncated)
  // so a history list can show something other than a timestamp.
  title String?

  messages AssistantMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model AssistantMessage {
  id String @id @default(uuid())

  conversationId String
  conversation   AssistantConversation @relation(fields: [conversationId], references: [id])

  role    AssistantMessageRole
  content String

  createdAt DateTime @default(now())

  @@index([conversationId, createdAt])
}

model UserContext {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  // Free-form, lightweight cross-module memory - deliberately Json rather
  // than normalized tables for v1: both the messaging module and the
  // assistant module read/write this, and its shape will keep growing
  // (search history once #21 lands, viewed listings, etc.) - Json avoids a
  // migration every time a new kind of memory gets added.
  recentSearches Json @default("[]")
  recentlyViewed Json @default("[]")

  // Rolling summary the AI assistant maintains and reads across both
  // modules, e.g. "client requesting a plumbing quote in Krakow, spoke to 2
  // providers, narrowing down on price" - this is the actual "shared memory"
  // the two chat modules communicate through, distinct from raw message history.
  summary String?

  updatedAt DateTime @updatedAt
}

// One row per orchestrator run (one repo/task pair from lead.py's subtask
// breakdown) - holds the final outcome that today only gets printed to the
// terminal (branch, PR URL, verdict). ExecutionMetric stays as the granular
// per-node-call telemetry log; this is the run-level summary the dashboard's
// history view reads. Same runId as the ExecutionMetric rows it's grouped
// with - written directly over Postgres from orchestrator/control_server.py,
// same as telemetry.py.
enum OrchestratorRunStatus {
  running
  done
  blocked
  failed
}

model OrchestratorRun {
  id String @id @default(uuid())

  runId           String                @unique
  repo            String
  taskDescription String
  status          OrchestratorRunStatus @default(running)

  branch String?
  prUrl  String?

  reviewVerdict String?
  reviewNotes   String?

  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  @@index([status, startedAt])
}

// Cost/telemetry log for the Python orchestrator (../orchestrator), NOT
// written to via Prisma/Nest - the orchestrator has no Node runtime, so it
// writes here directly over Postgres (asyncpg) using this same DATABASE_URL.
// This model exists purely so the table's shape is version-controlled and
// migrated the same way as the rest of the schema; see orchestrator/telemetry.py
// for the actual INSERT and orchestrator/nodes.py for the call sites (one row
// per provider call: classify_task's Groq/Gemini/Claude-Haiku attempts, each
// writer attempt, each security_review attempt).
model ExecutionMetric {
  id String @id @default(uuid())

  // Groups every row from one `main.py`/`lead.py` invocation together - a
  // single task can produce several rows (classify + writer + review, or
  // more on a review-retry loop). Generated in orchestrator/repos.py's
  // initial_state_for(), NOT a foreign key - the orchestrator doesn't have
  // (and shouldn't need) a corresponding "run" row of its own here.
  runId String

  // Which of REPOS' keys this run targeted (backend, frontend-shell, ...) -
  // see orchestrator/repos.py.
  repo String

  // Which graph node produced this call: classify_task, writer, security_review.
  node String

  // Which provider actually served the call: groq, gemini, or claude.
  provider String
  model    String

  inputTokens  Int?
  outputTokens Int?

  // Only populated for Claude Agent SDK calls - ResultMessage.total_cost_usd
  // already accounts for the real per-model pricing, so it's stored as-is
  // rather than recomputed from token counts. Groq/Gemini rows leave this
  // null (their APIs don't return a cost figure) - token counts are the
  // proxy for cost on those rows.
  totalCostUsd Decimal? @db.Decimal(10, 4)

  durationMs Int
  success    Boolean

  // Populated on failed attempts (provider errors, transient retries that
  // ultimately gave up) - null on success.
  errorMessage String?

  createdAt DateTime @default(now())

  @@index([runId])
  @@index([repo, createdAt])
}
