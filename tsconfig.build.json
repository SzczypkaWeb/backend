{
  "extends": "./tsconfig.json",
  // Deliberately NOT overriding rootDir back to "./src" here (an earlier
  // version of this file did) - that flattened the emit to dist/main.js,
  // but the Dockerfile's runtime stage has always run
  // `node dist/src/main.js` (nested), matching the base config's rootDir
  // "." unchanged. Keeping rootDir "." here preserves that existing,
  // already-deployed path. Only "include" is narrowed to src/**/* - without
  // it, the base config's default "everything in the project" pattern also
  // pulls in root-level/prisma/ scripts (prisma.config.ts, prisma/seed.ts,
  // prisma/backfill-google-auth-provider.ts) that are run standalone via
  // ts-node (see package.json scripts) and were never meant to be part of
  // the Nest build.
  "include": ["src/**/*"],
  "exclude": ["node_modules", "test", "dist", "**/*spec.ts"]
}
